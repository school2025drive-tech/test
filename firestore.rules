rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidScore(data) {
      return data.keys().hasAll(['userId', 'userName', 'mode', 'score', 'lines', 'level', 'timeMs', 'createdAt'])
        && data.keys().hasOnly(['userId', 'userName', 'userPhoto', 'mode', 'score', 'lines', 'level', 'timeMs', 'createdAt'])
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() > 0 && data.userName.size() <= 64
        && (!('userPhoto' in data) || (data.userPhoto is string && data.userPhoto.size() <= 512))
        && data.mode in ['MARATHON', 'SPRINT', 'ULTRA']
        && data.score is number && data.score >= 0 && data.score <= 10000000
        && data.lines is number && data.lines >= 0 && data.lines <= 10000
        && data.level is number && data.level >= 1 && data.level <= 100
        && data.timeMs is number && data.timeMs >= 0
        && data.createdAt == request.time;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName', 'gamesPlayed', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'displayName', 'photoURL', 'gamesPlayed', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.gamesPlayed is number && data.gamesPlayed >= 0
        && data.updatedAt == request.time;
    }

    // Connectivity probe document for client initialization check
    match /test/{docId} {
      allow get: if true;
    }

    // Global High Scores collection
    match /scores/{scoreId} {
      // Anyone can read and query global leaderboard rankings
      allow read: if true;

      // Only authenticated users can submit their own score with strict schema
      allow create: if isSignedIn()
        && isValidId(scoreId)
        && isValidScore(incoming());

      // Scores are permanent records and cannot be tampered with or deleted
      allow update, delete: if false;
    }

    // User Profile & stats collection
    match /users/{userId} {
      allow read: if true;

      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming());

      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId;

      allow delete: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid;
    }
  }
}
